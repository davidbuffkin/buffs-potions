{
  "multipart": [
    { "when": { "facing": "north", "lit": "false" }, "apply": { "model": "buffs_potions:block/brewing_still", "y": 180 } },
    { "when": { "facing": "east", "lit": "false" }, "apply": { "model": "buffs_potions:block/brewing_still", "y": 270 } },
    { "when": { "facing": "south", "lit": "false" }, "apply": { "model": "buffs_potions:block/brewing_still" } },
    { "when": { "facing": "west", "lit": "false" }, "apply": { "model": "buffs_potions:block/brewing_still", "y": 90 } },
    { "when": { "facing": "north", "lit": "true" }, "apply": { "model": "buffs_potions:block/brewing_still_lit", "y": 180 } },
    { "when": { "facing": "east", "lit": "true" }, "apply": { "model": "buffs_potions:block/brewing_still_lit", "y": 270 } },
    { "when": { "facing": "south", "lit": "true" }, "apply": { "model": "buffs_potions:block/brewing_still_lit" } },
    { "when": { "facing": "west", "lit": "true" }, "apply": { "model": "buffs_potions:block/brewing_still_lit", "y": 90 } },
    { "when": { "has_bottle": "true", "facing": "north" }, "apply": { "model": "buffs_potions:block/brewing_still_bottle", "y": 180 } },
    { "when": { "has_bottle": "true", "facing": "east" }, "apply": { "model": "buffs_potions:block/brewing_still_bottle", "y": 270 } },
    { "when": { "has_bottle": "true", "facing": "south" }, "apply": { "model": "buffs_potions:block/brewing_still_bottle" } },
    { "when": { "has_bottle": "true", "facing": "west" }, "apply": { "model": "buffs_potions:block/brewing_still_bottle", "y": 90 } }
  ]
}
